{
  "Otlp": {
    "Endpoint": ""
  },
  "ReverseProxy": {
    "Routes": {
      "public-user-service-route": {
        "ClusterId": "user-service-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/{action:regex(^(register|authorize)$)}"
        },
        "Transforms": [
          { "PathPattern": "/api/users/{action}" }
        ]
      },
      "private-user-service-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/users/{**catch-all}" }
        ],
        "AuthorizationPolicy": "AdminOnly"
      },
      "route-links": {
        "ClusterId": "cluster-links",
        "Match": {
          "Path": "/link/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/link/{**catch-all}" }
        ]
      },
      "route-redirect": {
        "ClusterId": "cluster-redirect",
        "Match": {
          "Path": "/r/{code}"
        },
        "Transforms": [
          { "PathPattern": "/api/redirect/{code}" }
        ]
      }
    },
    "Clusters": {
      "cluster-links": {},
      "cluster-redirect": {},
      "user-service-cluster": {}
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
