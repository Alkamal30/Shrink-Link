{
  "ReverseProxy": {
    "Routes": {
      "route-links": {
        "ClusterId": "cluster-links",
        "Match": {
          "Path": "/link/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/link/{**catch-all}"}
        ]
      },
      "route-redirect": {
        "ClusterId": "cluster-redirect",
        "Match": {
          "Path": "/{code}"
        },
        "Transforms": [
          { "PathPattern": "/api/redirect/{code}" }
        ]
      }
    },
    "Clusters": {
      "cluster-links": {
      },
      "cluster-redirect": {
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
