{
  "ReverseProxy": {
    "Routes": {
      "well-known-route": {
        "ClusterId": "auth-service-cluster",
        "Match": {
          "Path": "/.well-known/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/.well-known/{**catch-all}" }
        ]
      },
      "public-auth-service-route": {
        "ClusterId": "auth-service-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/auth/{**catch-all}" }
        ]
      },
      "public-user-service-route": {
        "ClusterId": "user-service-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/{action:regex(^(register|authorize|me)$)}"
        },
        "Transforms": [
          { "PathPattern": "/api/users/{action}" }
        ]
      },
      "private-user-service-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/users/{**catch-all}" }
        ],
        "AuthorizationPolicy": "AdminOnly"
      },
      "route-links": {
        "ClusterId": "cluster-links",
        "Match": {
          "Path": "/link/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/link/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "cluster-links": { },
      "cluster-redirect": { },
      "user-service-cluster": {},
      "auth-service-cluster": {}
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
